<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi galería"
            android:textColor="@color/texto"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="multimedia simple"
            android:textColor="#888888"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto"
                android:visibility="invisible" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/animateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton_principal"
            android:text="Mostrar imagen"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="18sp" />

        <!-- Intents implicitos -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCamara"
            style="@style/BotonApp"
            android:text="📷 Tomar foto" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGaleria"
            style="@style/BotonApp"
            android:text="🖼️ Elegir de galería" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWeb"
            style="@style/BotonApp"
            android:text="🌐 Abrir página web" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCorreo"
            style="@style/BotonApp"
            android:text="✉️ Enviar correo" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnWifi"
            style="@style/BotonApp"
            android:text="📶 Configuración Wi-Fi" />

        <!-- Intents explicitos -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDetalle"
            style="@style/BotonApp"
            android:text="🔍 Ver detalle de la imagen" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnForm"
            style="@style/BotonApp"
            android:text="📝 Formulario" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAyuda"
            style="@style/BotonApp"
            android:text="❓ Ayuda" />
    </LinearLayout>
</ScrollView>