<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mi galería"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textColor="@color/texto" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="multimedia simple"
            android:textSize="18sp"
            android:textColor="#888888" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/tarjeta"
            android:padding="12dp">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:visibility="invisible"
                android:src="@drawable/foto" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/animateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/boton_principal"
            android:textAllCaps="false"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:text="Mostrar imagen" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/playAudioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/boton_minimal"
            android:textAllCaps="false"
            android:textColor="@color/texto_suave"
            android:textSize="18sp"
            android:text="Reproducir audio" />

        <VideoView
            android:id="@+id/myVideoView"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/playVideoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/boton_minimal"
            android:textAllCaps="false"
            android:textColor="@color/texto_suave"
            android:textSize="18sp"
            android:text="Reproducir video" />
    </LinearLayout>
</ScrollView>