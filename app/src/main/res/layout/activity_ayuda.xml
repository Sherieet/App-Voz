<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ayuda"
            android:textColor="@color/texto"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/texto"
            android:textSize="18sp"
            android:text="• Mostrar imagen: muestra u oculta la foto con animacion.\n\n• Tomar foto: abre la camara del telefono y guarda la foto en la galeria.\n\n• Elegir de galeria: busca una imagen y la muestra aqui.\n\n• Abrir pagina web: abre el navegador.\n\n• Enviar correo: abre tu app de correo con el mensaje listo.\n\n• Configuracion Wi-Fi: abre los ajustes del sistema.\n\n• Ver detalle: muestra la imagen actual en otra pantalla.\n\n• Formulario: envia tu nombre y correo y espera una confirmacion." />

        <Button
            android:id="@+id/btnVolverAyuda"
            style="@style/BotonApp"
            android:layout_marginTop="24dp"
            android:text="Volver" />
    </LinearLayout>
</ScrollView>